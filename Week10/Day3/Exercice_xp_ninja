print("--- Exercise 1: Cars ---")

# Convert string to list programmatically
cars_string = "Volkswagen, Toyota, Ford Motor, Honda, Chevrolet"
manufacturers = [m.strip() for m in cars_string.split(",")]

# Number of manufacturers
print(f"Number of manufacturers: {len(manufacturers)}")

# Reverse/descending order (Z-A)
sorted_desc = sorted(manufacturers, reverse=True)
print(f"Descending order (Z-A): {sorted_desc}")

# Count names with letter 'o' (case-insensitive)
with_o = sum(1 for name in manufacturers if 'o' in name.lower())
print(f"Manufacturers with 'o': {with_o}")

# Count names without letter 'i' (case-insensitive)
without_i = sum(1 for name in manufacturers if 'i' not in name.lower())
print(f"Manufacturers without 'i': {without_i}")

# --- Bonus 1: Remove duplicates ---
print("\n--- Bonus: Duplicates ---")
duplicates_list = ["Honda", "Volkswagen", "Toyota", "Ford Motor", "Honda", "Chevrolet", "Toyota"]

# Remove duplicates while preserving order using dict.fromkeys()
unique_manufacturers = list(dict.fromkeys(duplicates_list))

# Comma-separated string with no line-breaks
unique_string = ", ".join(unique_manufacturers)
print(f"Unique companies: {unique_string}")
print(f"Number of unique companies: {len(unique_manufacturers)}")

# --- Bonus 2: Ascending order with reversed letters ---
print("\n--- Bonus: Ascending + Reversed Letters ---")
sorted_asc = sorted(unique_manufacturers)
reversed_names = [name[::-1] for name in sorted_asc]
print(f"Ascending with reversed letters: {reversed_names}")

print("\n" + "=" * 50 + "\n")

